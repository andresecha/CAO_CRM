.venv/
.tools
.tools/
imports/vendor/
imports/merged.ttl
validation/*/out/
docs/.tools/
__pycache__/
*.pyc

# NB: unlike the GitLab institutional mirror, /documentation and /decisions are NOT
# ignored here -- this is the primary repository, and both are public-facing content
# (see README.md sections 7-8), meant to be tracked and versioned normally.

# docs/site/ is intentionally NOT ignored in this delivery package -- it's committed
# as a ready-to-view artifact, regenerate with `make docs` if the ontology changes.

# Widoco's own serialization copies (RDF/XML, Turtle, N-Triples, JSON-LD),
# superseded by the versioned, permanently-linked files in ontology/
# (CAO_CRM-1.0.rdf/.ttl/.nt/.jsonld) -- docs/config-*.properties' download
# links point there, not here, so these regenerated duplicates are no longer
# referenced from anywhere and don't need to be committed.
docs/site/ontology.owl
docs/site/ontology.ttl
docs/site/ontology.nt
docs/site/ontology.jsonld

# public/ is GitHub Pages' own build output (see .github/workflows/pages.yml) --
# it's a straight copy of docs/site/ made fresh by every workflow run, never
# meant to be committed itself.
public/

# Italian: AI-assisted draft translation, not yet reviewed by a native speaker.
# Not wired into docs/build.sh's language loop, and not committed until Simone
# Rebora returns docs/i18n/review/review-it.md and the corrections are carried in.
# Do not delete -- this is deliberate work in progress, not dead weight. The step
# by step is in docs/prompts/RETOMAR-it-publicacion.md.
documentation/it/
docs/intro-it.html
docs/config-it.properties
docs/i18n/translations-it/
docs/i18n/glossary_crosswalk-it.yaml
docs/i18n/CAO_CRM-1.0-i18n-it.ttl

# Portuguese is published: its translation layer was reviewed by Ana Salgado
# (2026-09-04) and is wired into docs/build.sh, so everything the pt build consumes
# is tracked. One Portuguese exception stays ignored, on purpose: documentation/pt/,
# the ten pedagogical .md files, was not part of that review -- it is still an
# unreviewed AI-assisted draft, exactly as with Romanian.
documentation/pt/

# Romanian is published: its translation layer was reviewed by a native speaker
# (2026-09-01) and is wired into docs/build.sh, so everything the ro build consumes
# is tracked. Two Romanian exceptions stay ignored, on purpose:
#   - documentation/ro/, the ten pedagogical .md files, was explicitly left out of
#     that review and is still an unreviewed AI-assisted draft;
#   - docs/i18n/review/, the round-trip review documents themselves (including the
#     corrected review2-ro.md), which are working material, not a published artifact.
documentation/ro/
docs/i18n/review/
